# ============================================
# Segunda Vuelta - Environment Variables
# ============================================

# Google OAuth (omitir si no se tiene)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Google Maps
GOOGLE_MAPS_API_KEY=

# JWT
JWT_SECRET=sv-2026-production-secret-key-change-this
JWT_REFRESH_SECRET=sv-2026-refresh-secret-key-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MySQL (WAMP)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=segunda_vuelta
DB_USER=root
DB_PASSWORD=

# Server
PORT=3001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Admin
ADMIN_EMAIL=admin@segundavuelta.com
ADMIN_PASSWORD=Admin2026!SV

# FastAPI
AI_SERVICE_URL=http://localhost:8000
